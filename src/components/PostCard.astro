---
interface Props {
  title: string;
  description: string;
  date: Date;
  href: string;
  tags?: string[];
}

const { title, description, date, href, tags = [] } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={href} class="group block">
  <article class="py-4 border-b border-gray-100">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="font-medium group-hover:text-blue-600 transition-colors">
        {title}
      </h3>
      <time class="shrink-0 text-sm text-gray-400" datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </div>
    <p class="mt-1 text-sm text-gray-500 line-clamp-2">{description}</p>
    {tags.length > 0 && (
      <div class="mt-2 flex gap-2">
        {tags.map((tag) => (
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
            {tag}
          </span>
        ))}
      </div>
    )}
  </article>
</a>
