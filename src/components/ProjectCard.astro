---
interface Props {
  title: string;
  description: string;
  href: string;
  tags?: string[];
  github?: string;
  live?: string;
}

const { title, description, href, tags = [], github, live } = Astro.props;
---

<a href={href} class="group block rounded-lg border border-gray-200 p-5 transition-colors hover:border-gray-300">
  <h3 class="font-medium group-hover:text-blue-600 transition-colors">{title}</h3>
  <p class="mt-1.5 text-sm text-gray-500 line-clamp-2">{description}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs text-gray-500">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
