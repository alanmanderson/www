---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const professional = (await getCollection("professional")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const personal = (await getCollection("personal")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const recentProfessional = professional.slice(0, 3);
const recentPersonal = personal.slice(0, 3);
const featuredProjects = projects.slice(0, 3);
---

<BaseLayout title="Alan Anderson">
  <section class="mb-12">
    <h1 class="text-3xl font-bold tracking-tight">Alan Anderson</h1>
    <p class="mt-3 text-gray-500 leading-relaxed">
      Welcome to my corner of the internet. I write about software engineering,
      share personal thoughts, and showcase projects I'm working on.
    </p>
  </section>

  {recentProfessional.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-xl font-semibold">Blog</h2>
        <a href="/blog" class="text-sm text-gray-400 hover:text-gray-600">View all &rarr;</a>
      </div>
      {recentProfessional.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          href={`/blog/${post.id}`}
          tags={post.data.tags}
        />
      ))}
    </section>
  )}

  {recentPersonal.length > 0 && (
    <section class="mb-12">
      <div class="flex items-baseline justify-between mb-2">
        <h2 class="text-xl font-semibold">Personal</h2>
        <a href="/personal" class="text-sm text-gray-400 hover:text-gray-600">View all &rarr;</a>
      </div>
      {recentPersonal.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          href={`/personal/${post.id}`}
          tags={post.data.tags}
        />
      ))}
    </section>
  )}

  {featuredProjects.length > 0 && (
    <section>
      <div class="flex items-baseline justify-between mb-4">
        <h2 class="text-xl font-semibold">Projects</h2>
        <a href="/projects" class="text-sm text-gray-400 hover:text-gray-600">View all &rarr;</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${project.id}`}
            tags={project.data.tags}
          />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
