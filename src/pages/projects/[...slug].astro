---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Alan Anderson`} description={project.data.description}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{project.data.title}</h1>
      <p class="mt-2 text-gray-500">{project.data.description}</p>
      <div class="mt-4 flex gap-4 text-sm">
        <a href={project.data.github} class="text-blue-600 hover:underline" target="_blank" rel="noopener">
          GitHub
        </a>
        {project.data.live && (
          <a href={project.data.live} class="text-blue-600 hover:underline" target="_blank" rel="noopener">
            Live Demo
          </a>
        )}
      </div>
      {project.data.tags.length > 0 && (
        <div class="mt-3 flex gap-2">
          {project.data.tags.map((tag) => (
            <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs text-gray-600">
              {tag}
            </span>
          ))}
        </div>
      )}
    </header>
    <div class="prose prose-gray max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
